  {
    "type": "ThingDef",
    "key": "Drebbbd.description",
    "english": "When an Ebbb goes insane, it starts forcibly and violently assimilating with any other Ebbbs it comes across. This phenomenon is called a Drebbbd.",
    "french": "Lorsqu'un ebbb devient fou, il se met à fusionner de force et avec violence avec tous les autres ebbbs qu'il croise. Ce phénomène est appelé drebbbd.",
    "source": "Mod/Defs/ThingDefs_Races/Races_Ebbb.xml"
  },
