  {
    "type": "ThingDef",
    "key": "Leather_Ebbb.description",
    "english": "Tanned, dried, scraped ebbb leather. It feels wrong to touch this...",
    "french": "Du cuir d'ebbb tanné, séché et raclé. Le toucher provoque une sensation de malaise...",
    "source": "Mod/Defs/ThingDefs_Items/Items_Resource_Ebbb.xml"
  },
  {
    "type": "ThingDef",
    "key": "ThrumebbbHorn.label",
    "english": "thrumebbb horn",
    "french": "corne de thrumebbb",
    "source": "Mod/Defs/ThingDefs_Items/Items_Resource_Ebbb.xml"
  },
  {
    "type": "ThingDef",
    "key": "ThrumebbbHorn.description",
    "english": "A thrumebbb's horn. It's a gloopy mess, constantly oozing disgusting black goo. Useless for anything except for being a trophy.",
    "french": "Une corne de thrumebbb. Cette masse visqueuse suinte sans cesse une glu noire répugnante. Elle ne sert à rien, si ce n'est de trophée.",
    "source": "Mod/Defs/ThingDefs_Items/Items_Resource_Ebbb.xml"
  },
